###############################################################################
# Pa_mSikA — Environment Variables EXAMPLE
# Copy this to .env and fill in real values before deploying.
###############################################################################

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development   # change to "production" when live

# ── Supabase / PostgreSQL ─────────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → Database → URI
#
# Option A — Direct connection (for running Alembic migrations locally):
#   Host: db.<your-project-ref>.supabase.co  Port: 5432
#
# Option B — Supabase connection pooler (recommended for production app):
#   Go to Project Settings → Database → Connection Pooling
#   Host: aws-0-<region>.pooler.supabase.com  Port: 6543  Mode: Transaction
#
# For local dev / migrations use the direct URL (port 5432).
# For deployed app use the pooler URL (port 6543) to handle more connections.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_supabase_db_password
POSTGRES_DB=postgres

# Direct connection (use for: alembic migrations, local dev)
DATABASE_URL=postgresql://postgres:CHANGE_ME_supabase_db_password@db.CHANGE_ME_project_ref.supabase.co:5432/postgres
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:CHANGE_ME_supabase_db_password@db.CHANGE_ME_project_ref.supabase.co:5432/postgres

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
USE_REDIS=false

# ── JWT & Security ────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_hex_string

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ADMIN_TOKEN_EXPIRE_MINUTES=480

# Generate with: python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost","http://127.0.0.1","https://yourdomain.com","https://www.yourdomain.com"]
ALLOWED_HOSTS=["*"]

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# ── Cookies ───────────────────────────────────────────────────────────────────
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
